rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function active() {
      return signedIn()
        && request.auth.token.status == 'active'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == request.auth.token.role
        && (
          request.auth.token.role != 'customer'
          || request.auth.token.email_verified == true
        );
    }

    function hasRole(role) {
      return active() && request.auth.token.role == role;
    }

    function platformStaff() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function merchantFor(storeId) {
      return hasRole('merchant')
        && request.auth.token.storeIds is list
        && request.auth.token.storeIds.hasAny([storeId]);
    }

    function onboardingMerchantOwner(store) {
      return signedIn()
        && request.auth.token.role == 'merchant'
        && (request.auth.token.status == 'pending_profile' || request.auth.token.status == 'pending_approval')
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == request.auth.token.status
        && store.merchantId == request.auth.uid
        && store.status == 'draft'
        && (store.approvalState == 'pending' || store.approvalState == 'rejected');
    }

    function activeMerchantOwner(store) {
      return hasRole('merchant') && store.merchantId == request.auth.uid;
    }

    function publicStore(store) {
      return store.status == 'active' && store.approvalState == 'approved';
    }

    function publicItem(item) {
      return item.status == 'active'
        && exists(/databases/$(database)/documents/stores/$(item.storeId))
        && publicStore(get(/databases/$(database)/documents/stores/$(item.storeId)).data);
    }

    function assignedDriver(orderId) {
      return hasRole('driver')
        && exists(/databases/$(database)/documents/driverAssignments/$(orderId))
        && get(/databases/$(database)/documents/driverAssignments/$(orderId)).data.driverId == request.auth.uid;
    }

    function canReadOrder(orderId, order) {
      return active() && (
        order.customerId == request.auth.uid
        || merchantFor(order.storeId)
        || assignedDriver(orderId)
        || platformStaff()
      );
    }

    function canReadDriverAssignment(assignment) {
      return active() && (
        assignment.driverId == request.auth.uid
        || merchantFor(assignment.storeId)
        || platformStaff()
      );
    }

    match /users/{userId} {
      allow get: if (signedIn() && request.auth.uid == userId) || platformStaff();
      allow list: if platformStaff();
      allow write: if false;
    }

    match /stores/{storeId} {
      allow get, list: if publicStore(resource.data)
        || platformStaff()
        || merchantFor(storeId)
        || activeMerchantOwner(resource.data)
        || onboardingMerchantOwner(resource.data);
      allow write: if false;
    }

    match /items/{itemId} {
      allow get, list: if publicItem(resource.data)
        || platformStaff()
        || merchantFor(resource.data.storeId);
      allow write: if false;
    }

    match /importBatches/{batchId} {
      allow get, list: if platformStaff()
        || (active() && resource.data.requestedBy == request.auth.uid);
      allow write: if false;

      match /rows/{rowId} {
        allow get, list: if platformStaff()
          || (
            active()
            && get(/databases/$(database)/documents/importBatches/$(batchId)).data.requestedBy == request.auth.uid
          );
        allow write: if false;
      }
    }

    match /orders/{orderId} {
      allow get, list: if canReadOrder(orderId, resource.data);
      allow write: if false;
    }

    match /checkoutSessions/{checkoutId} {
      allow get: if active() && resource.data.customerId == request.auth.uid;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if active() && resource.data.recipientId == request.auth.uid;
      allow write: if false;
    }

    match /driverAssignments/{orderId} {
      allow get, list: if canReadDriverAssignment(resource.data);
      allow write: if false;
    }

    match /driverLocations/{orderId} {
      allow get: if active() && (
        resource.data.customerId == request.auth.uid
        || merchantFor(resource.data.storeId)
        || assignedDriver(orderId)
        || platformStaff()
      );
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
