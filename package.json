{
  "name": "spacemansystems",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "node tools/scripts/enforce-pnpm.mjs",
    "build": "pnpm -r --if-present run build",
    "docs:check": "node tools/scripts/check-docs.mjs",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "test:native:e2e": "maestro test .maestro",
    "test:web:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "validate": "pnpm docs:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.15.32",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
