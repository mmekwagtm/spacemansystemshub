{
  "name": "spacemansystems",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "node tools/scripts/enforce-pnpm.mjs",
    "boundaries:check": "node tools/scripts/check-boundaries.mjs",
    "build": "corepack pnpm -r --if-present run build",
    "docs:check": "node tools/scripts/check-docs.mjs",
    "lint": "corepack pnpm -r --if-present run lint",
    "test": "corepack pnpm -r --if-present run test",
    "test:web:e2e:phase4": "node tools/scripts/run-phase4-playwright.mjs",
    "test:web:e2e": "corepack pnpm --filter @spaceman/admin-web build && corepack pnpm --filter @spaceman/merchant-web build && corepack pnpm --filter @spaceman/customer-web build && playwright test",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "validate": "corepack pnpm docs:check && corepack pnpm boundaries:check && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.15.32",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
