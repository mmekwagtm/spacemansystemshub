{
  "expo": {
    "name": "Spaceman Customer",
    "slug": "spaceman-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "spaceman-customer",
    "android": {
      "package": "com.customer.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/spaceman-icon-customer.png",
        "backgroundColor": "#0B1F2A"
      }
    },
    "icon": "./assets/spaceman-icon-customer.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/spaceman-icon-customer.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1F2A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9ea2a19-f922-4dca-838a-74addba509a2"
      }
    },
    "owner": "spaceman-builder",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d9ea2a19-f922-4dca-838a-74addba509a2"
    },
    "ios": {}
  }
}
