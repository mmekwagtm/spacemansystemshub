{
  "name": "@spaceman/firebase-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --out-dir lib --clean --external firebase-admin --external firebase-functions",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@spaceman/app-core": "workspace:*",
    "@spaceman/app-errors": "workspace:*",
    "@spaceman/app-functions": "workspace:*",
    "@spaceman/app-validation": "workspace:*",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
