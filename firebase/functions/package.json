{
  "name": "@spaceman/firebase-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --out-dir lib --clean --external firebase-admin --external firebase-functions",
    "lint": "eslint src --max-warnings 0",
    "bootstrap:super-admin": "node scripts/bootstrap-super-admin.mjs",
    "test": "vitest run",
    "test:identity:live": "node scripts/live-identity.mjs",
    "test:marketplace:live": "node scripts/live-marketplace.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "^7.0.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
